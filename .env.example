# Copy to .env for local development. No value here is a secret; every real
# secret is supplied out of band and has no default (ZT-006) — the process
# refuses to start without one.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Application role. In Azure this is a managed-identity token, not a password.
DATABASE_URL=postgres://spendifre_app@127.0.0.1:5432/spendifre
# Migrations run as a role that holds DDL; the app role must not (SEC-021).
MIGRATION_DATABASE_URL=postgres://spendifre_migrator@127.0.0.1:5432/spendifre

# TLS on the app -> database hop. node-postgres does NOT negotiate TLS unless
# asked, so this is explicit. Production refuses `disable`.
#   disable      local container with no certificate
#   require      encrypt without verifying — stops a passive listener only
#   verify-full  encrypt and verify chain + hostname (use this)
# See docs/postgres-cert-auth.md.
DB_SSL_MODE=disable
# DB_CA_CERT=/etc/ssl/certs/db-ca.pem

# Salt for the IP / user-agent hashes on the session row (CMP-132 minimisation).
# Any long random string; rotating it simply invalidates relocation detection.
TELEMETRY_SALT=change-me-to-something-long-and-random

# SPEC §9.4. The deployment only serves entities whose residency matches.
# One of: eu | ch | apac | cn
RESIDENCY_REGION=eu
# Regions whose entities this deployment serves. Unset means "this one only".
# The group runs a single central deployment, so this is where the other
# jurisdictions are declared — and declaring one is a cross-border transfer
# that needs a lawful basis, not a config tweak (CMP-140).
# SERVED_REGIONS=eu,ch,apac
# Countries within those regions, as ISO 3166-1 alpha-2 codes. Unset means all
# of them. A region is a storage bucket, not a jurisdiction -- `apac` is
# Singapore, India and Vietnam at once -- so this is how a deployment says
# "serve Singapore but not Vietnam". It only ever narrows.
# SERVED_COUNTRIES=SE,NO,DK,FI,NL,DE,CH,SG
# How many replicas run this image. The rate limiter counts per process, so
# SEC-013's 600/minute is divided by this to keep the deployment-wide ceiling
# roughly what it says.
REPLICA_COUNT=1

FISCAL_YEAR=2026

# Which dataset `npm run db:seed` loads (ADR 0005). A deployment choice.
#   synthetic   invented; the default and the only mode allowed in production
#   anonymised  reads db/fixtures/anonymised.json, produced by
#               `node --experimental-strip-types tools/anonymise.ts`
# Neither mode reads design/budget-data.js — that file is Confidential.
SEED_MODE=synthetic
SEED_ANONYMISED_FILE=db/fixtures/anonymised.json

# Admin-triggered backups (ADR 0005). Archives are encrypted with AES-256-GCM;
# without a key the API refuses to create one rather than writing plaintext.
# 32 bytes of hex — generate with: openssl rand -hex 32
# In Azure this comes from Key Vault and BACKUP_DIR is a Blob container with
# customer-managed keys and an immutability policy.
BACKUP_DIR=./var/backups
# BACKUP_ENCRYPTION_KEY=

# Local sign-in stub. loadConfig refuses this in production.
DEV_AUTH=on

# Entra ID (ZT-002). Required in production; the client secret comes from
# Key Vault, never from this file.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
