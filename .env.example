# Copy to .env for local development. No value here is a secret; every real
# secret is supplied out of band and has no default (ZT-006) — the process
# refuses to start without one.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# Application role. In Azure this is a managed-identity token, not a password.
DATABASE_URL=postgres://spendifre_app@127.0.0.1:5432/spendifre
# Migrations run as a role that holds DDL; the app role must not (SEC-021).
MIGRATION_DATABASE_URL=postgres://spendifre_migrator@127.0.0.1:5432/spendifre

# Salt for the IP / user-agent hashes on the session row (CMP-132 minimisation).
# Any long random string; rotating it simply invalidates relocation detection.
TELEMETRY_SALT=change-me-to-something-long-and-random

# SPEC §9.4. The deployment only serves entities whose residency matches.
# One of: eu | ch | apac | cn
RESIDENCY_REGION=eu

FISCAL_YEAR=2026

# Local sign-in stub. loadConfig refuses this in production.
DEV_AUTH=on

# Entra ID (ZT-002). Required in production; the client secret comes from
# Key Vault, never from this file.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
